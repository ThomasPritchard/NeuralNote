# Local Claude settings (personal, not shared) + runtime lock
.claude/settings.local.json
.claude/scheduled_tasks.lock

# macOS
.DS_Store

# Build artifacts (the project will become a Tauri + web app)
/target/
node_modules/
dist/
build/
app/desktop/src-tauri/binaries/ollama-*
app/desktop/src-tauri/binaries/llama-server-*
# Ignore both the fetched directory and temporary absolute symlinks used by
# isolated worktrees; neither is reviewed source or release provenance.
app/desktop/src-tauri/ollama-libs

# Coverage + SonarQube scanner artifacts
coverage/
/app/desktop/artifacts/
/app/desktop/e2e-native/artifacts/
# Unanchored so it ignores the generated report anywhere (the root one Sonar reads,
# and a stray app/lcov-rust.info that a root-anchored `/lcov-rust.info` let slip in).
lcov-rust.info
.scannerwork/

# Logs & env
*.log
.env
.env.*
!.env.sonar.example

# Stray pasted screenshots at the repo root (PA-033)
/clipboard-*.png

# Production-audit working artifact (never committed; deleted on remediation)
/production-audit-report.md

# Vault app-state directories. Created inside any vault the apps open — including
# the QA fixture vault — and they hold machine-local paths and UI state, so they
# are never source. `prepare-note-test-vault.mjs` copies a vault wholesale, so
# leaving these tracked would seed a fresh manual vault with another machine's state.
.neuralnote/
.obsidian/

# Marketing/social assets: large generated PNG masters and backgrounds, kept local.
output/marketing/
