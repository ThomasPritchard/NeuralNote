{
  "name": "neuralnote-e2e-native",
  "private": true,
  "version": "0.3.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Tier-2 native WebDriver tests using WebdriverIO's embedded Tauri provider on Linux, macOS, and Windows.",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "test": "npm run typecheck && npm run test:config && tsx ./run-native.ts",
    "test:config": "tsx --test ./*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@wdio/cli": "^9.29.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "@wdio/types": "^9.29.1",
    "expect-webdriverio": "^5.0.0",
    "tsx": "^4.22.4",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "@wdio/native-utils": "2.6.0",
    "diff": "8.0.3",
    "serialize-javascript": "7.0.5",
    "mocha": "^11.7.6"
  }
}
